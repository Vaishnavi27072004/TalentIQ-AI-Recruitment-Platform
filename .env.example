# Copy this file to backend/.env and fill in your own values. NEVER commit the real .env file.

# --- Security ---
SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# Replace all demo passwords before sharing or deploying publicly.

# --- Database and local storage ---
DATABASE_URL=sqlite:///./recruitment.db
UPLOAD_DIR=uploads
CHROMA_DIR=chroma_db

# --- LLM for resume parsing: "groq" or "gemini" ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=60

# --- Embeddings ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Resume upload rules ---
MAX_RESUME_SIZE_MB=5
ALLOWED_RESUME_EXTENSIONS=[".pdf",".docx"]
MIN_RESUME_TEXT_CHARS=50

# --- Database alternatives ---
# For MySQL, install PyMySQL and use:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/recruitment?charset=utf8mb4
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/recruitment

# --- Matching weights (must add up to 1.0) ---
WEIGHT_SKILLS=0.35
WEIGHT_EXPERIENCE=0.25
WEIGHT_EDUCATION=0.10
WEIGHT_PREFERRED=0.10
WEIGHT_SEMANTIC=0.20
SEMANTIC_LOW=0.15
SEMANTIC_HIGH=0.75
STRONG_MATCH_THRESHOLD=75
POSSIBLE_MATCH_THRESHOLD=50

# --- Email (leave SMTP_HOST empty to only write a dev log file, nothing is sent) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=recruitment@example.com

# --- CORS: URLs of the React app ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MCP client (VS Code prompts for credentials; do not store them in this file) ---
# TALENTFLOW_API_URL=http://127.0.0.1:8000
# TALENTFLOW_EMAIL=
# TALENTFLOW_PASSWORD=
